#!/bin/bash

# THIS PRE-COMMIT WILL CHECK THAT ALL .TSX FILES HAVE A TEST FILE CREATED AND THAT ALL TESTS CONTAIN A a11y TEST

echo "🐾 Starting pre-commit hook..."

# Get the list of all staged files
STAGED_FILES=$(git diff --cached --name-only)

echo "Staged files: $STAGED_FILES"

# Initialize a variable to hold the test files that need a11y checks
TEST_FILES_TO_CHECK=""

# Loop through each staged file
for file in $STAGED_FILES; do
  # Skip non-TSX files
  if echo "$file" | grep -qv '\.tsx$'; then
    continue
  fi

  # Determine the corresponding test file
  test_file="${file%.tsx}.test.tsx"

  # Check if the corresponding test file exists
  if [ ! -f "$test_file" ]; then
    echo "❌ Test file missing for $file"
    exit 1  # Exit with a non-zero status to prevent the commit
  fi

  # If it's a test file, add it to the list for a11y checks
  if echo "$file" | grep -q '\.test\.tsx$'; then
    TEST_FILES_TO_CHECK="$TEST_FILES_TO_CHECK $file"
  fi
done

echo "✅ All .tsx files have corresponding test files. Proceeding with a11y test check."

# If no test files need to be checked for a11y, exit gracefully
if [ -z "$TEST_FILES_TO_CHECK" ]; then
  echo "✅ No test files to check for a11y tests. Proceeding with commit."
else
  MISSING_A11Y_TESTS=""

  # Check if each test file contains an a11y test
  for TEST_FILE in $TEST_FILES_TO_CHECK; do
    if ! grep -E "toHaveNoViolations|axe\(" "$TEST_FILE" > /dev/null; then
      MISSING_A11Y_TESTS="$MISSING_A11Y_TESTS $TEST_FILE"
    fi
  done

  # If any test files are missing an a11y test, prevent commit
  if [ -n "$MISSING_A11Y_TESTS" ]; then
    echo "❌ ERROR: The following test files are missing an a11y test (axe or toHaveNoViolations):"
    for FILE in $MISSING_A11Y_TESTS; do
      echo "  - $FILE"
    done
    echo "💡 Please add an a11y test before committing."
    exit 1
  fi
fi

# If all checks pass, show a success message
echo "✅ All test files contain an a11y test. Proceeding with commit."

# Run tests, lint, and format only if all checks pass
bun run test:merge
bun run lint
bun run format

exit 0
